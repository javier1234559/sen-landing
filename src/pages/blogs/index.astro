---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import PageMeta from "@/components/PageMeta.astro";
import BlogList from "@/components/feature/BlogList.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout>
  <PageMeta slot="meta" title="Blogs" description="Articles and notes." />
  <section slot="main" class="mx-auto min-h-[70vh] max-w-3xl px-6 py-12">
    <h1 class="mb-8 font-display text-5xl font-bold">Blogs</h1>
    <BlogList posts={posts} />
  </section>
</PageLayout>
