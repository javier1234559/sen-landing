---
import { SITE_TITLE } from "@/config";
import { CONTACT_LINKS, SITE_LINKS, SOCIAL_LINKS } from "@/config/siteLinks";
---

<header class="sen-header">
  <div class="sen-header-main">
    <a href={SITE_LINKS.home} class="sen-logo" aria-label={`${SITE_TITLE} home`}>
      <img src="/sen/brand/logo-new.svg" alt="Sến" />
    </a>
    <nav aria-label="Main navigation" class="sen-nav">
      <ul>
        <li><a href={SITE_LINKS.home}>Trang chủ</a></li>
        <li><a href={SITE_LINKS.about}>Câu chuyện thương hiệu</a></li>
        <li><a href={SITE_LINKS.collection}>Bộ sưu tập</a></li>
        <li><a href={SITE_LINKS.contact}>Liên hệ</a></li>
      </ul>
    </nav>
    <div class="sen-header-tools">
      <a class="sen-header-cta" href={SITE_LINKS.collection}>Khám phá bộ sưu tập <span>↗</span></a>
      <div class="sen-actions" aria-label="Quick actions">
        <button type="button" class="menu-button" data-menu-toggle aria-expanded="false" aria-controls="sen-menu" aria-label="Mở menu"><img src="/sen/icons/icon-hambuger.svg" alt="" /></button>
      </div>
    </div>
  </div>
</header>

<div class="sen-menu-backdrop" data-menu-close></div>
<aside id="sen-menu" class="sen-menu" aria-hidden="true" aria-label="Menu Sến">
  <div class="sen-menu-head"><span>Menu</span><button type="button" data-menu-close aria-label="Đóng menu">×</button></div>
  <nav class="sen-menu-nav" aria-label="Menu mở rộng">
    <a href={SITE_LINKS.home}>Trang chủ</a>
    <a href={SITE_LINKS.about}>Câu chuyện thương hiệu</a>
    <a href={SITE_LINKS.collection}>Bộ sưu tập</a>
    <a href={SITE_LINKS.contact}>Liên hệ</a>
  </nav>
  <form class="sen-search" role="search">
    <img src="/sen/icons/icon-search.svg" alt="" />
    <input type="search" placeholder="Tìm kiếm sản phẩm, bài viết, cảm hứng phối đồ..." aria-label="Tìm kiếm" />
  </form>
  <div class="sen-menu-contact"><a href={CONTACT_LINKS.phone}>{CONTACT_LINKS.phoneLabel}</a><a href={CONTACT_LINKS.email}>{CONTACT_LINKS.emailLabel}</a></div>
  <div class="sen-menu-socials" aria-label="Mạng xã hội">
    <a class="social-icon" href={SOCIAL_LINKS.instagram.href} target="_blank" rel="noreferrer" aria-label={SOCIAL_LINKS.instagram.label}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>
    <a class="social-icon" href={SOCIAL_LINKS.facebook.href} target="_blank" rel="noreferrer" aria-label={SOCIAL_LINKS.facebook.label}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3c-3.3 0-5 2-5 5v3H6v4h3v5h4v-5h3.5l.5-4H13V9c0-.7.3-1 1-1Z" fill="currentColor"/></svg></a>
    <a class="social-icon" href={SOCIAL_LINKS.tiktok.href} target="_blank" rel="noreferrer" aria-label={SOCIAL_LINKS.tiktok.label}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4v10.2a3.4 3.4 0 1 1-2.5-3.3V8.2A7.2 7.2 0 1 0 17 14V8.7c1.1.8 2.4 1.2 4 1.2V6.5c-2.2 0-3.8-1-4.5-2.5H14Z" fill="currentColor"/></svg></a>
  </div>
</aside>

<script>
  const menu = document.querySelector("#sen-menu");
  const toggle = document.querySelector("[data-menu-toggle]");
  const closers = document.querySelectorAll("[data-menu-close]");

  const setMenuState = (open: boolean) => {
    document.body.classList.toggle("menu-open", open);
    menu?.classList.toggle("is-open", open);
    menu?.setAttribute("aria-hidden", String(!open));
    toggle?.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () => setMenuState(!menu?.classList.contains("is-open")));
  closers.forEach((closer) => closer.addEventListener("click", () => setMenuState(false)));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenuState(false)));
</script>
